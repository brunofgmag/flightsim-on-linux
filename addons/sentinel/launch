#!/usr/bin/env bash
set -euo pipefail

HERE="$(dirname "$(readlink -f "$0")")"
# shellcheck source=tools/addon-launch.sh
. "$HERE/../../tools/addon-launch.sh"
# shellcheck source=tools/addons-prefix.sh
. "$HERE/../../tools/addons-prefix.sh"
# shellcheck source=tools/shim.sh
. "$HERE/../../tools/shim.sh"
# shellcheck source=addons/sentinel/parts/common.sh
. "$HERE/parts/common.sh"

addon_refuse_second "$SENTINEL_PATTERN"
if [ ! -f "$(addon_sibling_prefix)/system.reg" ]; then
  addon_say sentinel "the add-ons prefix does not exist; run: flightsim-on-linux addon apply addons-prefix"
  exit 1
fi
sentinel="$(shim_path sentinel "$SENTINEL_FILE")"
log="$(addon_log_file sentinel)"

cd "$(addon_sibling_prefix)"
addon_sibling_prefix_wine "$(addon_windows_path "$sentinel")" > "$log" 2>&1 &
disown
