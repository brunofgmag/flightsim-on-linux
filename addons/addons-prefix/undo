#!/usr/bin/env bash
set -euo pipefail

HERE="$(dirname "$(readlink -f "$0")")"
# shellcheck source=tools/addons-prefix.sh
. "$HERE/../../tools/addons-prefix.sh"

addon_sibling_cfg remove addons-prefix
echo "the add-ons prefix $(addon_sibling_prefix) stays; it holds a copy of the simulator's registry and the settings of the programs that run there. flightsim-on-linux addon watcher addons-prefix --off takes out the service. To delete the prefix, close its programs and run: rm -r '$(addon_sibling_prefix)' '$(addon_sibling_prefix)-gstreamer'"
