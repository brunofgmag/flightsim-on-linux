#!/usr/bin/env bash
set -euo pipefail

HERE="$(dirname "$(readlink -f "$0")")"
# shellcheck source=tools/addon-launch.sh
. "$HERE/../../tools/addon-launch.sh"
# shellcheck source=tools/addons-prefix.sh
. "$HERE/../../tools/addons-prefix.sh"
# shellcheck source=tools/shim.sh
. "$HERE/../../tools/shim.sh"
# shellcheck source=addons/addons-prefix/parts/common.sh
. "$HERE/parts/common.sh"
NO_DESKTOP=1

addon_refuse_second "$HOLDER_PATTERN"
if [ ! -f "$(addon_sibling_prefix)/system.reg" ]; then
  addon_say addons-prefix "the add-ons prefix does not exist; run: flightsim-on-linux addon apply addons-prefix"
  exit 1
fi
holder="$(shim_path desktop-holder "$HOLDER_FILE")"
log="$(addon_log_file addons-prefix)"

cd "$(addon_sibling_prefix)"
(
  status=0
  WINEDEBUG=err+all addon_sibling_prefix_wine "$(addon_windows_path "$holder")" || status=$?
  if [ "$status" = "$NO_DESKTOP" ]; then
    echo "no desktop in the add-ons prefix; restarting its Wine server"
    addon_sibling_prefix_kill || true
  fi
) > "$log" 2>&1 &
disown
