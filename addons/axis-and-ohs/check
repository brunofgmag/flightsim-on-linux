#!/usr/bin/env bash
set -uo pipefail

HERE="$(dirname "$(readlink -f "$0")")"
# shellcheck source=tools/addons-prefix.sh
. "$HERE/../../tools/addons-prefix.sh"
status=0

addon_sibling_prefix_check axis-and-ohs || status=1
if [ -f "$(addon_sibling_prefix)/system.reg" ]; then
  addon_sibling_cfg check axis-and-ohs || status=1
fi
python3 -I "$HERE/parts/aao.py" check "$(addon_sibling_prefix)" "${FSOL_PROTON:-}" || status=1
exit "$status"
