#!/usr/bin/env bash
set -euo pipefail

HERE="$(dirname "$(readlink -f "$0")")"
# shellcheck source=tools/addon-launch.sh
. "$HERE/../../tools/addon-launch.sh"

given="${FSOL_INSTALLER:?no installer given; run: flightsim-on-linux addon install just-flight-rj-professional <the zip or the setup.exe>}"

setup="$given"
if [[ "${given,,}" == *.zip ]]; then
  if ! command -v unzip > /dev/null; then
    echo "just-flight-rj-professional: unzip is not installed; install it, or unpack the zip yourself and give addon install the setup.exe inside it" >&2
    exit 1
  fi
  work="$(mktemp -d "${TMPDIR:-/tmp}/fsol-rj.XXXXXX")"
  trap 'rm -rf "$work"' EXIT
  unzip -q "$given" -d "$work"
  setup="$(find "$work" -iname setup.exe | sort | sed -n 1p)"
  if [ -z "$setup" ]; then
    echo "just-flight-rj-professional: there is no setup.exe inside $given" >&2
    exit 1
  fi
fi

addon_alone "$setup"
