#!/usr/bin/env bash
set -euo pipefail

HERE="$(dirname "$(readlink -f "$0")")"
# shellcheck source=/dev/null
. "$HERE/parts/common.sh"
PARTS=(dotnet geometry dxvk exe_xml)
for part in "${PARTS[@]}"; do
  # shellcheck source=/dev/null
  . "$HERE/parts/$part.sh"
done

addon_prefix_free_or_say fenix-a320
for part in "${PARTS[@]}"; do
  "${part}_apply"
done
