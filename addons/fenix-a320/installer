#!/usr/bin/env bash
set -euo pipefail

HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
ROOT="${FSOL_ROOT:-$(cd "$HERE/../.." && pwd)}"
CLI="${FSOL_CLI:-$ROOT/bin/flightsim-on-linux}"
DISCRETE_GPU="${FSOL_DISCRETE_GPU:-$ROOT/tools/discrete-gpu.py}"
SESSION="$HERE/parts/installer-session.sh"
APPID=2537590
FENIX_DOWNLOADS="https://fenixsim.com"

die() {
  echo "fenix installer: $*" >&2
  if [ ! -t 2 ] && command -v notify-send > /dev/null; then
    notify-send -a "Fenix Installer" -i dialog-information "Fenix Installer" "$*" || true
  fi
  exit 1
}

require_programs() {
  local missing=() program
  for program in gamescope protontricks; do
    command -v "$program" > /dev/null || missing+=("$program")
  done
  [ "${#missing[@]}" -eq 0 ] || die "missing program: ${missing[*]} (install gamescope and protontricks from your distribution)"
}

require_closed() {
  if pgrep -f 'FlightSimulator2024[.]exe' > /dev/null; then
    die "close Microsoft Flight Simulator 2024 first; the Fenix Installer runs alone in the prefix"
  fi
  if pgrep -f 'FenixApp[.]exe' > /dev/null; then
    die "the Fenix Installer is already open"
  fi
}

machine_field() {
  python3 -I -c 'import json, sys; value = json.loads(sys.argv[1]).get(sys.argv[2]); print(", ".join(value) if isinstance(value, list) else (value if value else ""))' "$machine" "$1"
}

require_free_prefix() {
  [ -n "$(machine_field prefix_in_use)" ] || return 0
  local programs
  programs="$(machine_field prefix_programs)"
  if [ -n "$programs" ]; then
    die "close $programs first; the Fenix Installer crashes on start while another program holds the prefix"
  fi
  die "Wine is still running in the prefix; wait a few seconds and try again"
}

preferred_device() {
  local errors status=0 device message
  errors="$(mktemp)"
  device="$("$DISCRETE_GPU" --vk-device 2> "$errors")" || status=$?
  message="$(tr '\n' ' ' < "$errors")"
  rm -f "$errors"
  [ "$status" -eq 0 ] || die "cannot choose the GPU for the installer: ${message:-$DISCRETE_GPU exited with $status}"
  echo "$device"
}

require_programs
require_closed

machine="$("$CLI" machine --json)"
prefix="$(machine_field prefix)"
[ -n "$prefix" ] || die "$CLI machine finds no simulator prefix; run it and read what it reports"
require_free_prefix
install_dir="$prefix/drive_c/users/steamuser/AppData/Local/FenixApp"
app_dir="$install_dir/current"
[ -f "$app_dir/FenixApp.exe" ] || die "FenixApp.exe is not in $app_dir; download the Fenix Installer from $FENIX_DOWNLOADS and run it once"

device="$(preferred_device)"
options=()
if [ -n "$device" ]; then
  options=(--prefer-vk-device "$device")
fi

cd "$install_dir"
exec env -u WAYLAND_DISPLAY gamescope "${options[@]}" -W 1333 -H 1000 -w 1200 -h 900 -- \
  protontricks --no-term -c "$(printf '%q' "$SESSION")" "$APPID"
