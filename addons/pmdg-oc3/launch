#!/usr/bin/env bash
set -euo pipefail

HERE="$(dirname "$(readlink -f "$0")")"
# shellcheck source=tools/addon-launch.sh
. "$HERE/../../tools/addon-launch.sh"
PATTERN='^[A-Za-z]:.*\\PMDG OC3\.exe'

addon_refuse_second "$PATTERN"
exe="$(compgen -G "$FSOL_PREFIX/drive_c/users/*/AppData/Local/Programs/pmdg-oc3/PMDG OC3.exe" | head -n 1 || true)"
if [ -z "$exe" ]; then
  addon_say pmdg-oc3 "PMDG OC3 is not installed; run: flightsim-on-linux addon launch pmdg-oc3 update"
  exit 1
fi
log="$(addon_log_file pmdg-oc3)"

addon_beside_simulator "$(addon_windows_path "$exe")" --disable-gpu-sandbox --disable-gpu "$@" > "$log" 2>&1 &
disown
