#!/usr/bin/env bash
set -euo pipefail

HERE="$(dirname "$(readlink -f "$0")")"
# shellcheck source=tools/addon-launch.sh
. "$HERE/../../tools/addon-launch.sh"
KEY='HKCU\Software\Wine\AppDefaults\PMDG OC3.exe\X11 Driver'
BACKUP="$FSOL_COMPATDATA/flightsim-on-linux-backup/pmdg-oc3"

current="$(python3 -I "$HERE/parts/decorated.py" value "$FSOL_PREFIX")"
if [ "$current" = N ]; then
  echo "already PMDG OC3 is set not to ask the window manager for a frame"
  exit 0
fi
mkdir -p "$BACKUP"
if [ ! -e "$BACKUP/decorated" ] && [ ! -e "$BACKUP/decorated.absent" ]; then
  if [ -n "$current" ]; then
    printf '%s' "$current" > "$BACKUP/decorated"
  else
    : > "$BACKUP/decorated.absent"
  fi
fi
addon_alone reg add "$KEY" /v Decorated /t REG_SZ /d N /f > /dev/null
[ "$(python3 -I "$HERE/parts/decorated.py" value "$FSOL_PREFIX")" = N ] || { echo "pmdg-oc3: the registry still has no Decorated=N for PMDG OC3.exe after reg add" >&2; exit 2; }
echo "changed PMDG OC3.exe is set not to ask the window manager for a frame (Decorated=N; the earlier state is in $BACKUP)"
