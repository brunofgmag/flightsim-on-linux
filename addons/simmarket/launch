#!/usr/bin/env bash
set -euo pipefail

HERE="$(dirname "$(readlink -f "$0")")"
# shellcheck source=tools/addon-launch.sh
. "$HERE/../../tools/addon-launch.sh"
PATTERN='^[A-Za-z]:.*\\simMarket\\app-[^\\]*\\simMarket\.exe'

addon_refuse_second "$PATTERN"
exe="$(addon_newest "$FSOL_PREFIX/drive_c/users/*/AppData/Local/simMarket/app-*/simMarket.exe")"
if [ -z "$exe" ]; then
  addon_say simmarket "simMarket is not installed; run: flightsim-on-linux addon install simmarket <installer>"
  exit 1
fi
log="$(addon_log_file simmarket)"

EXTRA_WINEDLLOVERRIDES=toaststub=d addon_beside_simulator "$(addon_windows_path "$exe")" --disable-gpu-sandbox "$@" > "$log" 2>&1 &
disown
