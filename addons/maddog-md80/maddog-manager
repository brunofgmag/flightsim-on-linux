#!/usr/bin/env bash
set -euo pipefail

HERE="$(dirname "$(readlink -f "$0")")"
# shellcheck source=tools/addon-launch.sh
. "$HERE/../../tools/addon-launch.sh"

if ! python3 -c 'import PyQt6.QtWidgets' 2> /dev/null; then
  addon_say maddog-md80 "the Maddog Manager needs PyQt6 for Python 3: install python-pyqt6 (Arch) or python3-pyqt6 (Debian, Ubuntu)"
  exit 1
fi
PYTHONPATH="$HERE/manager${PYTHONPATH:+:$PYTHONPATH}" exec python3 -B -m maddog_manager "$@"
