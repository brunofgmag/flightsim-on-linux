#!/usr/bin/env bash
set -euo pipefail

HERE="$(dirname "$(readlink -f "$0")")"
# shellcheck source=tools/addon-launch.sh
. "$HERE/../../tools/addon-launch.sh"
PATTERN='^[A-Za-z]:\\.*\\bbs_nest\.exe'

addon_refuse_second "$PATTERN"
exe="$(compgen -G "${FSOL_PREFIX:?FSOL_PREFIX is not set}/drive_c/users/*/AppData/Local/Programs/BlueBird Simulations/NEST/bbs_nest.exe" | head -n 1 || true)"
if [ -z "$exe" ]; then
  addon_say bbs-nest "BBS Nest is not installed; run: flightsim-on-linux addon install bbs-nest <BlueBirdNestSetup.exe>"
  exit 1
fi
folder="$(dirname "$exe")"
windows_folder="$(addon_windows_path "$folder")"
windows_exe="$windows_folder\\bbs_nest.exe"
log="$(addon_log_file bbs-nest)"

cd "$folder"
if [ "${FSOL_SIM_RUNNING:-0}" = 1 ]; then
  "$FSOL_CLI" run start /d "$windows_folder" "$windows_exe" "$@" > "$log" 2>&1 &
else
  addon_prefix_free_or_say bbs-nest
  addon_in_prefix "$windows_exe" "$@" > "$log" 2>&1 &
fi
disown
