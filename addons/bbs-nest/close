#!/usr/bin/env bash
set -euo pipefail

HERE="$(dirname "$(readlink -f "$0")")"
# shellcheck source=tools/addon-launch.sh
. "$HERE/../../tools/addon-launch.sh"
PATTERN='^[A-Za-z]:\\.*\\bbs_nest\.exe'

if ! pgrep -f -- "$PATTERN" > /dev/null; then
  echo "BBS Nest is not running"
  exit 0
fi
addon_beside_simulator taskkill /im bbs_nest.exe > /dev/null 2>&1 || true
if ! addon_wait_gone "$PATTERN"; then
  addon_say bbs-nest "BBS Nest is still open after its window was asked to close. Opened alone it does not close that way; to end it, run: pkill -9 -f 'NEST\\\\bbs_nest\\.ex[e]'"
  exit 1
fi
