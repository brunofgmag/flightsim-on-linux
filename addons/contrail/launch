#!/usr/bin/env bash
set -euo pipefail

HERE="$(dirname "$(readlink -f "$0")")"
# shellcheck source=tools/addon-launch.sh
. "$HERE/../../tools/addon-launch.sh"
# shellcheck source=/dev/null
. "$HERE/parts/contrail.sh"
PATTERN='^[A-Za-z]:.*\\ContrailApp\\app-[^\\]*\\Contrail\.exe'

addon_refuse_second "$PATTERN"
app="$(contrail_newest)"
if [ -z "$app" ]; then
  addon_say contrail "Contrail is not installed; run: flightsim-on-linux addon install contrail <ContrailSetup.exe>"
  exit 1
fi
contrail_install_into "$app" "$(shim_path winhttp-proxy winhttp.dll)"
log="$(addon_log_file contrail)"

EXTRA_WINEDLLOVERRIDES='d3d9=d;winhttp=n,b' addon_beside_simulator "$(addon_windows_path "$app/Contrail.exe")" "$@" > "$log" 2>&1 &
disown
