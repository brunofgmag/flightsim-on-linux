#!/usr/bin/env bash
set -euo pipefail

HERE="$(dirname "$(readlink -f "$0")")"
# shellcheck source=tools/addon-launch.sh
. "$HERE/../../tools/addon-launch.sh"
# shellcheck source=addons/flightsim-dispatch/parts/common.sh
. "$HERE/parts/common.sh"

addon_refuse_second "$DISPATCH_PATTERN"
if [ ! -f "$DISPATCH_FOLDER/FlightSimDispatch.exe" ]; then
  addon_say flightsim-dispatch "FlightSim Dispatch is not installed; run: flightsim-on-linux addon install flightsim-dispatch <FlightSimDispatch zip>"
  exit 1
fi
log="$(addon_log_file flightsim-dispatch)"

cd "$DISPATCH_FOLDER"
dispatch_wine wine 'C:\FlightSimDispatch\FlightSimDispatch.exe' "$@" > "$log" 2>&1 &
disown
