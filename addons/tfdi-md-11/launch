#!/usr/bin/env bash
set -euo pipefail

HERE="$(dirname "$(readlink -f "$0")")"
# shellcheck source=tools/addon-launch.sh
. "$HERE/../../tools/addon-launch.sh"
PATTERN='^[A-Za-z]:.*\\MD-11 Extended Simulation Package\.exe'

addon_refuse_second "$PATTERN"
exe="$(compgen -G "$FSOL_PREFIX/drive_c/users/*/AppData/Local/TFDi Design/MD-11 Extended Simulation/MD-11 Extended Simulation Package.exe" | head -n 1 || true)"
if [ -z "$exe" ]; then
  addon_say tfdi-md-11 "the MD-11 Extended Simulation package is not installed; install the MD-11 with its Install Manager first"
  exit 1
fi
log="$(addon_log_file tfdi-md-11)"

addon_beside_simulator "$(addon_windows_path "$exe")" "$@" > "$log" 2>&1 &
disown
