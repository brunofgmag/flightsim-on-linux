#!/usr/bin/env bash
set -euo pipefail

HERE="$(dirname "$(readlink -f "$0")")"
# shellcheck source=tools/addon-launch.sh
. "$HERE/../../tools/addon-launch.sh"
PARTS="$HERE/parts"
BACKUP="${FSOL_COMPATDATA:?FSOL_COMPATDATA is not set}/flightsim-on-linux-backup/bbs-757-weather-radar"
COMMUNITY="${FSOL_COMMUNITY:?no Community folder found; run: flightsim-on-linux machine}"
given="${FSOL_INSTALLER:-${1:-}}"
work=""

cleanup() {
  [ -z "$work" ] || rm -rf "$work"
}
trap cleanup EXIT

fail() {
  addon_say bbs-757-weather-radar "$1"
  exit 1
}

bundle_in() {
  find "$1" -maxdepth 3 -path '*/scripts/Install.ps1' -print -quit | sed 's|/scripts/Install.ps1$||'
}

[ -n "$given" ] || fail "no mod given; run: flightsim-on-linux addon install bbs-757-weather-radar <the mod's zip>, or, for a folder you unpacked yourself, flightsim-on-linux addon launch bbs-757-weather-radar install -- <folder>"
[ "${FSOL_SIM_RUNNING:-0}" != 1 ] || fail "close the simulator first; the radar changes files of the 757 package"
command -v pwsh > /dev/null || fail "pwsh (PowerShell 7) is not installed; the mod's installer needs it, and it needs no Wine prefix"

if [ -d "$given" ]; then
  root="$given"
else
  [ -f "$given" ] || fail "$given is neither a folder nor a zip file"
  work="$(mktemp -d "${TMPDIR:-/tmp}/bbs-radar.XXXXXX")"
  python3 -I -m zipfile -e "$given" "$work" || fail "$given cannot be unpacked as a zip file"
  root="$work"
fi
bundle="$(bundle_in "$root")"
[ -n "$bundle" ] || fail "no scripts/Install.ps1 under $given; give the mod's unpacked folder or its zip"

python3 -I "$PARTS/radar.py" backup "$COMMUNITY" "$BACKUP"
if ! pwsh -NoProfile -File "$PARTS/install-weather-radar.ps1" -Bundle "$bundle" -Community "$COMMUNITY"; then
  addon_say bbs-757-weather-radar "the mod's installer stopped; flightsim-on-linux addon undo bbs-757-weather-radar puts the 757 back as it was"
  exit 1
fi
