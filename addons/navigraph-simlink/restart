#!/usr/bin/env bash
set -euo pipefail

HERE="$(dirname "$(readlink -f "$0")")"
# shellcheck source=tools/addon-launch.sh
. "$HERE/../../tools/addon-launch.sh"
# shellcheck source=addons/navigraph-simlink/parts/common.sh
. "$HERE/parts/common.sh"

simlink_wine wine taskkill /f /im NavigraphSimlink.exe > /dev/null 2>&1 || true
if ! addon_wait_gone "$SIMLINK_PATTERN"; then
  addon_say navigraph-simlink "Simlink is still running after it was closed by force; not starting a second copy"
  exit 1
fi
exec "$HERE/launch"
