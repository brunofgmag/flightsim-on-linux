+async fn swipe_page(device_id: &str, forward: bool) -> Result<(), anyhow::Error> {
+	let current = crate::store::profiles::DEVICE_STORES.write().await.get_selected_profile(device_id)?;
+	let Some((group, _)) = current.rsplit_once('/') else { return Ok(()) };
+	let prefix = format!("{group}/Page ");
+	let mut pages: Vec<String> = crate::store::profiles::get_device_profiles(device_id)?
+		.into_iter()
+		.filter(|id| id.starts_with(&prefix) && !id.ends_with(".bak") && !id.ends_with(".temp"))
+		.collect();
+	pages.sort();
+	pages.dedup();
+	let Some(index) = pages.iter().position(|id| *id == current) else { return Ok(()) };
+	let target = if forward { (index + 1) % pages.len() } else { (index + pages.len() - 1) % pages.len() };
+	if target == index {
+		return Ok(());
+	}
+	crate::events::inbound::misc::switch_profile(crate::events::inbound::misc::SwitchProfileEvent {
+		device: device_id.to_owned(),
+		profile: pages[target].clone(),
+	})
+	.await
+}
