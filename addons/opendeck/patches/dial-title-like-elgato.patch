+fn encoder_title_override(state: &ActionState) -> Option<String> {
+	if !state.show {
+		return Some(String::new());
+	}
+	let text = state.text_override.clone().filter(|s| !s.is_empty()).unwrap_or_else(|| state.text.clone());
+	(!text.is_empty()).then_some(text)
+}
+
+#[cfg(test)]
+mod tests {
+	use super::*;
+
+	fn state(text: &str, show: bool) -> ActionState {
+		ActionState {
+			text: text.to_owned(),
+			show,
+			..Default::default()
+		}
+	}
+
+	#[test]
+	fn hidden_title_blanks_the_layout_title() {
+		assert_eq!(encoder_title_override(&state("DISP & WX", false)), Some(String::new()));
+	}
+
+	#[test]
+	fn whitespace_title_stays_blank_instead_of_falling_back_to_the_action_name() {
+		assert_eq!(encoder_title_override(&state(" ", true)), Some(" ".to_owned()));
+	}
+
+	#[test]
+	fn shown_title_keeps_its_text() {
+		assert_eq!(encoder_title_override(&state(" RANGE", true)), Some(" RANGE".to_owned()));
+	}
+
+	#[test]
+	fn empty_title_leaves_the_layout_title_alone() {
+		assert_eq!(encoder_title_override(&state("", true)), None);
+	}
+
+	#[test]
+	fn plugin_title_wins_over_the_saved_title() {
+		let state = ActionState {
+			text_override: Some("ALL DISP".to_owned()),
+			..state("DISP & WX", true)
+		};
+		assert_eq!(encoder_title_override(&state), Some("ALL DISP".to_owned()));
+	}
+
+	#[test]
+	fn hidden_title_also_hides_the_plugin_title() {
+		let state = ActionState {
+			text_override: Some("ALL DISP".to_owned()),
+			..state("DISP & WX", false)
+		};
+		assert_eq!(encoder_title_override(&state), Some(String::new()));
+	}
+}
