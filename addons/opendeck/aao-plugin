#!/usr/bin/env bash
set -euo pipefail

PLUGIN="${XDG_CONFIG_HOME:-${HOME:?HOME is not set}/.config}/opendeck/plugins/com.lorbysi.aao.sdPlugin/settings.js"
BACKUP="$PLUGIN.orig"
DEFAULT_PORT=43390

if [ ! -f "$PLUGIN" ]; then
  echo "the AAO plugin is not in OpenDeck's plugins folder: $PLUGIN does not exist" >&2
  exit 1
fi

if [ "${1:-}" = --restore ]; then
  [ -f "$BACKUP" ] || { echo "no copy of the plugin's own settings.js at $BACKUP" >&2; exit 1; }
  cp -p "$BACKUP" "$PLUGIN"
  rm "$BACKUP"
  echo "settings.js is the plugin's own again"
  exit 0
fi

port="${1:-$DEFAULT_PORT}"
case "$port" in
  '' | *[!0-9]*) echo "usage: aao-plugin [port | --restore]" >&2; exit 2 ;;
esac
if [ "$port" -lt 1 ] || [ "$port" -gt 65535 ]; then
  echo "$port is not a port" >&2
  exit 2
fi
grep -q '^const AAO_URL = "http://localhost:[0-9]*/webapi";' "$PLUGIN" || { echo "settings.js has no AAO_URL line this script knows; edit it by hand" >&2; exit 1; }

[ -f "$BACKUP" ] || cp -p "$PLUGIN" "$BACKUP"
sed -i "s|^const AAO_URL = \"http://localhost:[0-9]*/webapi\";|const AAO_URL = \"http://localhost:$port/webapi\";|" "$PLUGIN"
echo "the AAO plugin now talks to http://localhost:$port/webapi; its own settings.js is kept in $BACKUP"
