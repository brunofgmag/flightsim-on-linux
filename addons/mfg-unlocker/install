#!/usr/bin/env bash
set -euo pipefail

HERE="$(dirname "$(readlink -f "$0")")"
# shellcheck source=/dev/null
. "$HERE/parts/download.sh"
MFG_VERSION="1.7.1-xmx.2"
MFG_URL="https://github.com/brunofgmag/MFG-Unlocker/releases/download/v$MFG_VERSION/MFGUnlocker-v$MFG_VERSION.zip"
MFG_SHA256="2d5d36960df058037f596075b6509935624aaaacefd658c4ebe7970061f73944"
XESS_URL="https://github.com/intel/xess/releases/download/v3.0.2/XeSS_SDK_3.0.2.zip"
XESS_SHA256="88b8a373f30e33f3558a77a93e634f11b8132fc3047ea1a8edeead32b8471990"

sim="${FSOL_SIM_INSTALL:?no simulator install folder found; run: flightsim-on-linux machine}"
cache="${FSOL_CACHE:?FSOL_CACHE is not set}/downloads"

[ "${FSOL_SIM_RUNNING:-0}" != 1 ] || { echo "close the simulator before you install the add-on" >&2; exit 1; }

file="${FSOL_INSTALLER:-}"
if [ -z "$file" ]; then
  file="$cache/MFGUnlocker-v$MFG_VERSION.zip"
  mfg_fetch "$MFG_URL" "$MFG_SHA256" "$file"
else
  mfg_require "$file" "$MFG_SHA256"
fi
sdk="$cache/XeSS_SDK_3.0.2.zip"
mfg_fetch "$XESS_URL" "$XESS_SHA256" "$sdk"
exec python3 -I "$HERE/parts/mfg.py" install "$sim" "$file" "$MFG_SHA256" "$sdk" "$XESS_SHA256"
