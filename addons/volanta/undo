echo "the add-ons prefix $(addon_sibling_prefix) stays; it holds a copy of the simulator's registry and Volanta's settings. To delete it, close Volanta and run: rm -r '$(addon_sibling_prefix)' '$(addon_sibling_prefix)-gstreamer'"
