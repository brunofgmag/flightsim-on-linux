#!/usr/bin/env bash
set -euo pipefail

HERE="$(dirname "$(readlink -f "$0")")"
# shellcheck source=tools/addon-launch.sh
. "$HERE/../../tools/addon-launch.sh"
# shellcheck source=tools/addons-prefix.sh
. "$HERE/../../tools/addons-prefix.sh"
# shellcheck source=addons/volanta/parts/common.sh
. "$HERE/parts/common.sh"

addon_refuse_second "$VOLANTA_PATTERN"
exe="$(volanta_exe)"
if [ -z "$exe" ]; then
  addon_say volanta "Volanta is not installed; run: flightsim-on-linux addon install volanta <installer>"
  exit 1
fi
if [ ! -f "$(addon_sibling_prefix)/system.reg" ]; then
  addon_say volanta "the add-ons prefix does not exist; run: flightsim-on-linux addon apply volanta"
  exit 1
fi
log="$(addon_log_file volanta)"

cd "$(addon_sibling_prefix)"
addon_sibling_prefix_wine "$(addon_windows_path "$exe")" "$@" --in-process-gpu --disable-gpu --disable-gpu-compositing > "$log" 2>&1 &
disown
