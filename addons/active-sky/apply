#!/usr/bin/env bash
set -euo pipefail

HERE="$(dirname "$(readlink -f "$0")")"
ROOT="$(cd "$HERE/../.." && pwd)"
# shellcheck source=tools/addon-launch.sh
. "$HERE/../../tools/addon-launch.sh"
# shellcheck source=tools/registry.sh
. "$HERE/../../tools/registry.sh"
# shellcheck source=tools/addons-prefix.sh
. "$HERE/../../tools/addons-prefix.sh"
# shellcheck source=addons/active-sky/parts/carlito.sh
. "$HERE/parts/carlito.sh"
# shellcheck source=addons/active-sky/parts/program.sh
. "$HERE/parts/program.sh"

if ! carlito_installed; then
  echo "FAIL the Carlito font is not installed, and Calibri would have nothing to be replaced by; install the ttf-carlito package (Arch) or the package of your distribution that holds Carlito, then run apply again"
  exit 1
fi
: "${REGISTRY_BACKUP:?FSOL_COMPATDATA is not set}"
addon_sibling_prefix_create
addon_sibling_cfg write active-sky
cfg="$(addon_sibling_prefix)/SimConnect.cfg"
utils_cfg="$(active_sky_utils_cfg)"
if [ -z "$utils_cfg" ]; then
  echo "already ActiveSky Utils is not installed, so it needs no SimConnect.cfg yet; run apply again after the connector puts it in place"
elif cmp -s "$cfg" "$utils_cfg"; then
  echo "already SimConnect.cfg is next to ActiveSky Utils"
else
  cp "$cfg" "$utils_cfg"
  echo "changed copied SimConnect.cfg next to ActiveSky Utils, because Active Sky reopens Utils in that folder"
fi
addon_sibling_registry_set "$ACTIVE_SKY_KEY" Calibri Carlito
addon_sibling_registry_set "$ACTIVE_SKY_KEY" "Calibri Medium" Carlito

result="$(python3 -I "$ROOT/fsol/exe_xml.py" disable "${ACTIVE_SKY_EXE_XML:?no base folder found; run: flightsim-on-linux machine}" "$ACTIVE_SKY_UTILS_ENTRY")"
case "$result" in
  disabled)
    mkdir -p "$REGISTRY_BACKUP"
    : > "$ACTIVE_SKY_UTILS_MARK"
    echo "changed exe.xml: the ActiveSky Utils entry has Disabled true, so the simulator does not open a second one on its own Wine server"
    ;;
  already) echo "already the ActiveSky Utils entry in exe.xml has Disabled true" ;;
  *) echo "already exe.xml has no ActiveSky Utils entry; Active Sky writes one when it installs its connector, so run apply again after that" ;;
esac
