#!/usr/bin/env bash
set -euo pipefail

HERE="$(dirname "$(readlink -f "$0")")"
# shellcheck source=tools/addon-launch.sh
. "$HERE/../../tools/addon-launch.sh"

installer="${FSOL_INSTALLER:?no installer given; run: flightsim-on-linux addon install msfs-autofps <MSFS_AutoFPS-installer.exe>}"
widget="${FSOL_COMMUNITY:-}/autofps-html-widget-panel"

if [ -n "${FSOL_COMMUNITY:-}" ] && [ -L "$widget" ]; then
  target="$(readlink "$widget")"
  rm "$widget"
  echo "removed the link $widget, which pointed to $target: the installer replaces that folder through Windows calls, and Wine cannot delete a Linux link, so it stopped halfway"
fi

addon_alone WINEDLLOVERRIDES=d3d9=d "$installer"
