#!/usr/bin/env bash
set -euo pipefail

HERE="$(dirname "$(readlink -f "$0")")"
# shellcheck source=/dev/null
. "$HERE/parts/common.sh"
CURRENT_LOG="$A340_WORK/ToLissLog.txt"

recover_unfinished() {
  [ -f "$A340_SESSION" ] || return 0
  if a340_watcher_alive "$(a340_session_value id)"; then
    a340_fail "The tool is already on and its watcher is waiting for the simulator."
  fi
  a340_restore "Unfinished session recovered at the next start." || a340_fail "Recovery needed: close the simulator and run: flightsim-on-linux addon launch a340-performance-tool off"
}

a340_sim_running && a340_fail "MSFS 2024 is open. Close the simulator before turning the tool on."
[ -d "$A340_WORK" ] && [ ! -L "$A340_WORK" ] || a340_fail "The A340 work folder does not exist or is a link: $A340_WORK"
recover_unfinished
[ -f "$A340_PREVLOG" ] || a340_fail "ToLissPrevLog.txt does not exist yet. Fly the A340 once, close the simulator and turn the tool on again."
[ ! -L "$A340_PREVLOG" ] && [ -w "$A340_PREVLOG" ] || a340_fail "ToLissPrevLog.txt is already protected or is a link."
if [ -e "$CURRENT_LOG" ]; then
  [ ! -L "$CURRENT_LOG" ] && [ -w "$CURRENT_LOG" ] || a340_fail "ToLissLog.txt is protected or is a link."
fi

mkdir -p "$A340_STATE"
mode="$(stat -c %a "$A340_PREVLOG")"
id="$(cat /proc/sys/kernel/random/uuid)"
printf 'id=%s\nmode=%s\nactivated=%s\n' "$id" "$mode" "$(date -Iseconds)" > "$A340_SESSION"
chmod a-w "$A340_PREVLOG"
if [ -w "$A340_PREVLOG" ]; then
  a340_restore "Turning on failed; write access restored." > /dev/null
  a340_fail "ToLissPrevLog.txt did not become read-only."
fi
setsid -f "$HERE/parts/watch" "$id" > "$A340_STATE/watch.log" 2>&1
for _ in $(seq 36); do
  [ -f "$A340_STATE/watch_$id.ready" ] && break
  sleep 0.25
done
if [ ! -f "$A340_STATE/watch_$id.ready" ]; then
  a340_restore "The watcher did not start; write access restored." > /dev/null
  a340_fail "The watcher did not start. Turning on was undone."
fi
a340_set_last_event "On. The watcher waits for MSFS 2024 to open and close."
a340_say "On: ToLissPrevLog.txt is read-only. Start MSFS 2024; write access comes back when it closes."
