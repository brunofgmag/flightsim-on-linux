#!/usr/bin/env bash
set -euo pipefail

HERE="$(dirname "$(readlink -f "$0")")"
# shellcheck source=/dev/null
. "$HERE/common.sh"

id="$1"
seen=0
missing=0
started="$(date +%s)"

[ "$(a340_session_value id)" = "$id" ] || exit 0
echo $$ > "$A340_STATE/watch_$id.pid"
trap 'rm -f "$A340_STATE/watch_$id.ready" "$A340_STATE/watch_$id.pid"' EXIT
touch "$A340_STATE/watch_$id.ready"
while [ "$(a340_session_value id)" = "$id" ]; do
  if a340_sim_alive; then
    seen=1
    missing=0
  elif [ "$seen" = 1 ]; then
    missing=$((missing + 1))
    if [ "$missing" -ge 2 ]; then
      a340_restore "Restored automatically after MSFS 2024 closed." && break
      missing=1
    fi
  elif [ $(($(date +%s) - started)) -ge "$A340_IDLE_LIMIT" ]; then
    a340_restore "Restored automatically: the simulator did not open within 3 hours." && break
  fi
  sleep "$A340_POLL"
done
