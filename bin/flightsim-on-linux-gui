#!/usr/bin/env bash
set -uo pipefail

CLI="$(dirname "$(readlink -f "$0")")/flightsim-on-linux"
TITLE="Flightsim on Linux"
LOG="$(mktemp "${TMPDIR:-/tmp}/flightsim-on-linux-gui.XXXXXX")"
trap 'rm -f "$LOG"' EXIT

if [ -n "${FSOL_DIALOG:-}" ]; then
  DIALOG="$FSOL_DIALOG"
elif [ "${XDG_CURRENT_DESKTOP:-}" = KDE ] && command -v kdialog > /dev/null; then
  DIALOG=kdialog
elif command -v zenity > /dev/null; then
  DIALOG=zenity
elif command -v kdialog > /dev/null; then
  DIALOG=kdialog
else
  DIALOG=terminal
fi

SHOW_OUTPUT="Show output"
TERMINALS=(xdg-terminal-exec konsole gnome-terminal xfce4-terminal x-terminal-emulator xterm)
FOLLOW="tail -n +1 --pid=\"\$1\" -f \"\$2\"; printf '\\nFinished. Press Enter to close this window.'; read -r _"

show_text() {
  local title="$1" file="$2"
  case "$DIALOG" in
    zenity) zenity --text-info --width=760 --height=520 --title="$TITLE: $title" --filename="$file" --font=monospace ;;
    kdialog) kdialog --title "$TITLE: $title" --geometry 760x520 --textbox "$file" ;;
    *) echo "== $title"; cat "$file" ;;
  esac
}

choose() {
  case "$DIALOG" in
    zenity)
      zenity --list --radiolist --width=620 --height=380 --title="$TITLE" \
        --text="What do you want to do?" --column=" " --column=Action --column=Task --hide-column=3 --print-column=3 \
        TRUE "Fix my add-ons (apply and check)" addons \
        FALSE "Check the Proton the simulator uses" check \
        FALSE "Build Proton FS2024 (takes a few minutes)" build \
        FALSE "Run the setup check again" doctor
      ;;
    kdialog)
      kdialog --title "$TITLE" --geometry 620x320 --radiolist "What do you want to do?" \
        addons "Fix my add-ons (apply and check)" on \
        check "Check the Proton the simulator uses" off \
        build "Build Proton FS2024 (takes a few minutes)" off \
        doctor "Run the setup check again" off
      ;;
    *)
      echo "1) Fix my add-ons (apply and check)" >&2
      echo "2) Check the Proton the simulator uses" >&2
      echo "3) Build Proton FS2024" >&2
      echo "4) Run the setup check again" >&2
      read -r -p "Choice: " answer
      case "$answer" in 1) echo addons ;; 2) echo check ;; 3) echo build ;; 4) echo doctor ;; esac
      ;;
  esac
}

ADDON_TEXT="Pick the add-ons you have installed, or want to install now. Each one gets its fix, then a check that it works."

addon_rows() {
  "$CLI" addon list --json | python3 -I -c 'import json, sys
for row in json.load(sys.stdin):
    print("\t".join((row["id"], row["name"], row["status"])))'
}

pick_addons() {
  local id name status rows=() number=0
  local -a ids=()
  while IFS=$'\t' read -r id name status; do
    ids+=("$id")
    case "$DIALOG" in
      zenity) rows+=("$([ "$status" = "installed, not fixed" ] && echo TRUE || echo FALSE)" "$name" "$status" "$id") ;;
      kdialog) rows+=("$id" "$name: $status" "$([ "$status" = "installed, not fixed" ] && echo on || echo off)") ;;
      *) number=$((number + 1)); printf '%2d) %-32s %s\n' "$number" "$name" "$status" >&2 ;;
    esac
  done < <(addon_rows)
  [ "${#ids[@]}" -gt 0 ] || return 2
  case "$DIALOG" in
    zenity)
      zenity --list --checklist --width=720 --height=460 --title="$TITLE" --text="$ADDON_TEXT" \
        --column=" " --column=Add-on --column=Status --column=id --hide-column=4 --print-column=4 --separator=$'\n' "${rows[@]}"
      ;;
    kdialog)
      kdialog --title "$TITLE" --separate-output --checklist "$ADDON_TEXT" "${rows[@]}"
      ;;
    *)
      local answer choice
      read -r -p "Numbers to set up, separated by spaces: " answer
      for choice in $answer; do
        [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "${#ids[@]}" ] && echo "${ids[$((choice - 1))]}"
      done
      ;;
  esac
}

set_up_addons() {
  local chosen id name results status
  local -A names=()
  while IFS=$'\t' read -r id name status; do
    names[$id]="$name"
  done < <(addon_rows)
  chosen="$(pick_addons)"
  status=$?
  if [ "$status" -eq 2 ]; then
    echo "No add-on fixes are in this version yet. The add-on list on the website says what is coming." > "$LOG"
    show_text "add-ons" "$LOG"
    return
  fi
  [ -n "$chosen" ] || return
  results="$LOG.results"
  : > "$results"
  while IFS= read -r id; do
    [ -n "$id" ] || continue
    run_with_progress "Setting up ${names[$id]:-$id}" "$CLI" addon apply "$id"
    { cat "$LOG"; echo; } >> "$results"
  done <<< "$chosen"
  show_text "results" "$results"
  rm -f "$results"
}

terminal_command() {
  local name
  local -a preferred=()
  [ "${XDG_CURRENT_DESKTOP:-}" != KDE ] || preferred=(konsole)
  for name in ${TERMINAL:-} "${preferred[@]}" "${TERMINALS[@]}"; do
    command -v "$name" > /dev/null || continue
    case "$name" in
      xdg-terminal-exec) echo "$name" ;;
      gnome-terminal) echo "$name --" ;;
      xfce4-terminal) echo "$name -x" ;;
      *) echo "$name -e" ;;
    esac
    return 0
  done
  return 1
}

show_output() {
  local task="$1"
  local -a launcher
  if read -r -a launcher < <(terminal_command); then
    "${launcher[@]}" sh -c "$FOLLOW" sh "$task" "$LOG" > /dev/null 2>&1 &
  elif command -v zenity > /dev/null; then
    tail -n +1 --pid="$task" -f "$LOG" | zenity --text-info --auto-scroll --width=760 --height=520 --font=monospace --title="$TITLE: output" > /dev/null 2>&1 &
  else
    kdialog --title "$TITLE" --msgbox "No terminal was found. The output goes to $LOG while it runs." > /dev/null 2>&1 &
  fi
}

offer_output() {
  local text="$1" task="$2"
  kdialog --title "$TITLE" --yes-label "$SHOW_OUTPUT" --no-label "Close" --yesno "$text: you can follow its output while it runs." > /dev/null 2>&1 && show_output "$task"
}

stop_offer() {
  pkill -P "$1" 2> /dev/null
  kill "$1" 2> /dev/null
}

progress_call() {
  local ref="$1" method="$2"
  shift 2
  dbus-send --session --type=method_call --dest="${ref%% *}" "${ref##* }" "org.kde.kdialog.ProgressDialog.$method" "$@" 2> /dev/null
}

run_with_progress() {
  local text="$1"
  shift
  case "$DIALOG" in
    zenity)
      "$@" > "$LOG" 2>&1 &
      local pid=$! line button
      {
        while kill -0 "$pid" 2> /dev/null; do
          line="$(tail -n 1 "$LOG" | cut -c1-90)"
          [ -z "$line" ] || echo "# $line"
          sleep 1
        done
        echo 100
      } | zenity --progress --pulsate --auto-close --no-cancel --extra-button="$SHOW_OUTPUT" --width=620 --title="$TITLE" --text="$text" |
        while IFS= read -r button; do
          [ "$button" != "$SHOW_OUTPUT" ] || show_output "$pid"
        done
      wait "$pid"
      ;;
    kdialog)
      local ref status task offer
      ref="$(kdialog --title "$TITLE" --progressbar "$text" 0)"
      progress_call "$ref" showCancelButton boolean:false
      "$@" > "$LOG" 2>&1 &
      task=$!
      offer_output "$text" "$task" &
      offer=$!
      wait "$task"
      status=$?
      stop_offer "$offer"
      progress_call "$ref" close
      return "$status"
      ;;
    *)
      "$@" 2>&1 | tee "$LOG"
      return "${PIPESTATUS[0]}"
      ;;
  esac
}

main() {
  local task
  "$CLI" doctor > "$LOG" 2>&1
  show_text "your machine" "$LOG"

  while task="$(choose)" && [ -n "$task" ]; do
    case "$task" in
      addons)
        set_up_addons
        ;;
      check)
        run_with_progress "Testing Proton in a throwaway prefix" "$CLI" proton check
        { tail -n 1 "$LOG"; echo; cat "$LOG"; } > "$LOG.view"
        show_text "Proton check" "$LOG.view"
        rm -f "$LOG.view"
        ;;
      build)
        run_with_progress "Building Proton FS2024" "$CLI" proton build
        show_text "Proton build" "$LOG"
        ;;
      doctor)
        "$CLI" doctor > "$LOG" 2>&1
        show_text "your machine" "$LOG"
        ;;
    esac
  done
}

[ "${BASH_SOURCE[0]}" != "$0" ] || main
