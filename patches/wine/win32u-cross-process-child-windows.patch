+                 (surface = get_remote_window_surface( dce->hwnd, top_win, dce->flags & REMOTE_SURFACE_DC_FLAGS, &win_rect )))
+        {
+            top_rect = win_rect;
+        }
     }
 
+    set_dce_remote_surface( dce, surface );
+
     if (surface)
     {
         user_driver->pGetDC( dce->hdc, dce->hwnd, top_win, &win_rect, &top_rect, flags );
@@ -942,6 +1314,7 @@ static void release_dce( struct dce *dce )
     if (!dce->hwnd) return;  /* already released */
 
