+SECURITY_STATUS WINAPI NCryptSecretAgreement(NCRYPT_KEY_HANDLE privkey, NCRYPT_KEY_HANDLE pubkey,
+                                             NCRYPT_SECRET_HANDLE *secret, DWORD flags)
+{
+    struct object *priv = (struct object *)privkey, *pub = (struct object *)pubkey, *object;
+    NTSTATUS status;
+
+    TRACE("(%#Ix, %#Ix, %p, %#lx)\n", privkey, pubkey, secret, flags);
+
+    if (!priv || priv->type != KEY || !pub || pub->type != KEY) return NTE_INVALID_HANDLE;
+    if (!secret) return HRESULT_FROM_WIN32(RPC_X_NULL_REF_POINTER);
+    if (flags & ~NCRYPT_SILENT_FLAG) return NTE_BAD_FLAGS;
+
+    if (!(object = allocate_object(SECRET))) return NTE_NO_MEMORY;
+    status = BCryptSecretAgreement(priv->key.bcrypt_key, pub->key.bcrypt_key, &object->secret.bcrypt_secret, 0);
+    if (status != STATUS_SUCCESS)
+    {
+        free(object);
+        return map_ntstatus(status);
+    }
+
+    *secret = (NCRYPT_SECRET_HANDLE)object;
+    return ERROR_SUCCESS;
+}
+
+SECURITY_STATUS WINAPI NCryptDeriveKey(NCRYPT_SECRET_HANDLE handle, const WCHAR *kdf, NCryptBufferDesc *params,
+                                       BYTE *output, DWORD output_len, DWORD *ret_len, ULONG flags)
+{
+    struct object *object = (struct object *)handle;
+
+    TRACE("(%#Ix, %s, %p, %p, %lu, %p, %#lx)\n", handle, wine_dbgstr_w(kdf), params, output, output_len,
+          ret_len, flags);
+
+    if (!object || object->type != SECRET) return NTE_INVALID_HANDLE;
+
+    return map_ntstatus(BCryptDeriveKey(object->secret.bcrypt_secret, kdf, (BCryptBufferDesc *)params, output,
+                                        output_len, ret_len, flags & ~NCRYPT_SILENT_FLAG));
+}
