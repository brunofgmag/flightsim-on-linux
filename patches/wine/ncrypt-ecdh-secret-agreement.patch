+static const struct ecdh_curve
+{
+    enum algid algid;
+    const WCHAR *name;
+    const WCHAR *curve_name;
+    BCRYPT_ALG_HANDLE alg_handle;
+    DWORD bitlen;
+    ULONG public_magic;
+    ULONG private_magic;
+}
+ecdh_curves[] =
+{
+    { ECDH_P256, BCRYPT_ECDH_P256_ALGORITHM, L"nistP256", BCRYPT_ECDH_P256_ALG_HANDLE, 256,
+      BCRYPT_ECDH_PUBLIC_P256_MAGIC, BCRYPT_ECDH_PRIVATE_P256_MAGIC },
+    { ECDH_P384, BCRYPT_ECDH_P384_ALGORITHM, L"nistP384", BCRYPT_ECDH_P384_ALG_HANDLE, 384,
+      BCRYPT_ECDH_PUBLIC_P384_MAGIC, BCRYPT_ECDH_PRIVATE_P384_MAGIC },
+    { ECDH_P521, BCRYPT_ECDH_P521_ALGORITHM, L"nistP521", BCRYPT_ECDH_P521_ALG_HANDLE, 521,
+      BCRYPT_ECDH_PUBLIC_P521_MAGIC, BCRYPT_ECDH_PRIVATE_P521_MAGIC },
+};
+
+static const struct ecdh_curve *ecdh_curve_from_algid(enum algid algid)
+{
+    unsigned int i;
+    for (i = 0; i < ARRAY_SIZE(ecdh_curves); i++)
+        if (ecdh_curves[i].algid == algid) return &ecdh_curves[i];
+    return NULL;
+}
+
+static const struct ecdh_curve *ecdh_curve_from_name(const WCHAR *name)
+{
+    unsigned int i;
+    for (i = 0; i < ARRAY_SIZE(ecdh_curves); i++)
+        if (!lstrcmpiW(ecdh_curves[i].name, name)) return &ecdh_curves[i];
+    return NULL;
+}
+
+static const struct ecdh_curve *ecdh_curve_from_curve_name(const WCHAR *name)
+{
+    unsigned int i;
+    for (i = 0; i < ARRAY_SIZE(ecdh_curves); i++)
+        if (!lstrcmpiW(ecdh_curves[i].curve_name, name)) return &ecdh_curves[i];
+    return NULL;
+}
+
+static const struct ecdh_curve *ecdh_curve_from_magic(ULONG magic)
+{
+    unsigned int i;
+    for (i = 0; i < ARRAY_SIZE(ecdh_curves); i++)
+        if (ecdh_curves[i].public_magic == magic || ecdh_curves[i].private_magic == magic) return &ecdh_curves[i];
+    return NULL;
+}
