Wine ntdll: stop walking a free list after 64 blocks that are too small and go on to the next list, and let blocks up to 2 KiB reach the low fragmentation heap after 2048 allocations. With the FSLabs A321 and SayIntentions traffic, the process heap held about 40,000 free blocks of up to 1,504 bytes in one list, and every 1,520-byte request walked all of them under the heap lock, which stopped the simulator for 50 to 185 ms once a second.
Applies to wine-cachyos with: patch -p1 --forward --fuzz=0 -i <this file>

--- a/dlls/ntdll/heap.c
+++ b/dlls/ntdll/heap.c
@@ -176,6 +176,8 @@
 /* for reference, update this when changing parameters */
 C_ASSERT( FREE_LIST_COUNT == 0x3d );
 
+#define FREE_LIST_MAX_SCAN 64
+
 typedef struct DECLSPEC_ALIGN(BLOCK_ALIGN) tagSUBHEAP
 {
     SIZE_T __pad[sizeof(SIZE_T) / sizeof(DWORD)];
@@ -1129,6 +1131,7 @@
 static struct block *find_free_block( struct heap *heap, ULONG flags, SIZE_T block_size )
 {
     struct list *ptr = &find_free_list( heap, block_size, FALSE )->entry;
+    unsigned int scanned = 0, index;
     struct entry *entry;
     struct block *block;
     SIZE_T total_size;
@@ -1140,13 +1143,21 @@
     {
         entry = LIST_ENTRY( ptr, struct entry, entry );
         block = &entry->block;
-        if (block_get_flags( block ) == BLOCK_FLAG_FREE_LINK) continue;
+        if (block_get_flags( block ) == BLOCK_FLAG_FREE_LINK)
+        {
+            scanned = 0;
+            continue;
+        }
         if (block_get_size( block ) >= block_size)
         {
             if (!subheap_commit( heap, block_get_subheap( heap, block ), block, block_size )) return NULL;
             list_remove( &entry->entry );
             return block;
         }
+        if (++scanned < FREE_LIST_MAX_SCAN) continue;
+        scanned = 0;
+        index = get_free_list_index( block_get_size( block ) );
+        if (index + 1 < FREE_LIST_COUNT) ptr = &heap->free_lists[index + 1].entry;
     }
 
     /* make sure we can fit the block and a free entry at the end */
@@ -2007,7 +2018,7 @@
     BOOL enable = FALSE;
 
     if (bin == heap->bins && alloc > 0x10) enable = TRUE;
-    else if (bin - heap->bins < 0x30 && alloc > 0x800) enable = TRUE;
+    else if (bin - heap->bins < 0x40 && alloc > 0x800) enable = TRUE;
     else if (bin - heap->bins < 0x30 && alloc - freed > 0x10) enable = TRUE;
     else if (alloc - freed > 0x400000 / block_size) enable = TRUE;
     if (!enable) return;
