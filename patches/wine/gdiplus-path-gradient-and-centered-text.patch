+static BYTE gamma_to_linear(BYTE value)
+{
+    return gdip_round(powf(value / 255.0f, 2.2f) * 255.0f);
+}
+
+static BYTE linear_to_gamma(BYTE value)
+{
+    return gdip_round(powf(value / 255.0f, 1.0f / 2.2f) * 255.0f);
+}
+
+static ARGB argb_to_linear(ARGB color)
+{
+    return (color & 0xff000000) | gamma_to_linear((color >> 16) & 0xff) << 16 |
+        gamma_to_linear((color >> 8) & 0xff) << 8 | gamma_to_linear(color & 0xff);
+}
+
+static ARGB argb_to_gamma(ARGB color)
+{
+    return (color & 0xff000000) | linear_to_gamma((color >> 16) & 0xff) << 16 |
+        linear_to_gamma((color >> 8) & 0xff) << 8 | linear_to_gamma(color & 0xff);
+}
+
+static ARGB blend_colors_gamma(ARGB start, ARGB end, REAL position, BOOL gamma)
+{
+    if (!gamma)
+        return blend_colors(start, end, position);
+    return argb_to_gamma(blend_colors(argb_to_linear(start), argb_to_linear(end), position));
+}
+
+static REAL interpolate_blend_factor(const REAL *positions, const REAL *factors, INT count, REAL position)
+{
+    INT i = 1;
+
+    if (count < 2)
+        return position;
+
+    while (i < count - 1 && position > positions[i])
+        i++;
+
+    if (positions[i] == positions[i-1])
+        return factors[i];
+
+    return factors[i-1] + (factors[i] - factors[i-1]) *
+        (position - positions[i-1]) / (positions[i] - positions[i-1]);
+}
+
+static REAL path_gradient_position(const GpPathGradient *fill, REAL distance, REAL dx, REAL dy)
+{
+    REAL focus, weight;
+
+    if (distance <= 0.0f)
+        return 0.0f;
+    if (distance >= 1.0f)
+        return 1.0f;
+
+    weight = fabsf(dx) + fabsf(dy);
+    if (fill->focus.X == fill->focus.Y || weight == 0.0f)
+        focus = fill->focus.X;
+    else
+        focus = (fabsf(dx) * fill->focus.X + fabsf(dy) * fill->focus.Y) / weight;
+
+    if (focus <= 0.0f)
+        return distance;
+    if (focus >= 1.0f || 1.0f - distance <= focus)
+        return 1.0f;
+    return distance / (1.0f - focus);
+}
+
+static ARGB path_gradient_color(const GpPathGradient *fill, ARGB outer_color, REAL position)
+{
+    INT i = 1;
+
+    if (fill->pblendcount >= 2)
+    {
+        while (i < fill->pblendcount - 1 && position > fill->pblendpos[i])
+            i++;
+
+        if (fill->pblendpos[i] == fill->pblendpos[i-1])
+            return fill->pblendcolor[i];
+
+        return blend_colors_gamma(fill->pblendcolor[i-1], fill->pblendcolor[i],
+            (position - fill->pblendpos[i-1]) / (fill->pblendpos[i] - fill->pblendpos[i-1]), fill->gamma);
+    }
+
+    return blend_colors_gamma(outer_color, fill->centercolor,
+        interpolate_blend_factor(fill->blendpos, fill->blendfac, fill->blendcount, position), fill->gamma);
+}
