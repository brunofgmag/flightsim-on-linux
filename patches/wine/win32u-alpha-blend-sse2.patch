+#ifdef __SSE2__
+static inline __m128i blend_argb_pair( __m128i src, __m128i dst )
+{
+    __m128i alpha = _mm_shufflehi_epi16( _mm_shufflelo_epi16( src, 0xff ), 0xff );
+    __m128i scaled = _mm_mullo_epi16( dst, _mm_xor_si128( alpha, _mm_set1_epi16( 255 ) ) );
+    __m128i rounded = _mm_add_epi16( scaled, _mm_set1_epi16( 127 ) );
+    __m128i biased = _mm_add_epi16( _mm_add_epi16( rounded, _mm_srli_epi16( rounded, 8 ) ), _mm_set1_epi16( 1 ) );
+    return _mm_add_epi16( src, _mm_srli_epi16( biased, 8 ) );
+}
+#endif
+
+static void blend_argb_row( DWORD *dst, const DWORD *src, int width )
+{
+    int x = 0;
+#ifdef __SSE2__
+    const __m128i zero = _mm_setzero_si128();
+    const __m128i ones = _mm_set1_epi32( -1 );
+    const __m128i channel_max = _mm_set1_epi16( 255 );
+
+    for (; x + 4 <= width; x += 4)
+    {
+        __m128i src_pixels = _mm_loadu_si128( (const __m128i *)(src + x) );
+        __m128i dst_pixels, low, high;
+        int i;
+
+        if (_mm_movemask_epi8( _mm_cmpeq_epi32( src_pixels, zero ) ) == 0xffff) continue;
+        if ((_mm_movemask_epi8( _mm_cmpeq_epi8( src_pixels, ones ) ) & 0x8888) == 0x8888)
+        {
+            _mm_storeu_si128( (__m128i *)(dst + x), src_pixels );
+            continue;
+        }
+        dst_pixels = _mm_loadu_si128( (const __m128i *)(dst + x) );
+        low = blend_argb_pair( _mm_unpacklo_epi8( src_pixels, zero ), _mm_unpacklo_epi8( dst_pixels, zero ) );
+        high = blend_argb_pair( _mm_unpackhi_epi8( src_pixels, zero ), _mm_unpackhi_epi8( dst_pixels, zero ) );
+        if (_mm_movemask_epi8( _mm_cmpgt_epi16( _mm_or_si128( low, high ), channel_max ) ))
+            for (i = x; i < x + 4; i++) dst[i] = blend_argb( dst[i], src[i] );
+        else
+            _mm_storeu_si128( (__m128i *)(dst + x), _mm_packus_epi16( low, high ) );
+    }
+#endif
+    for (; x < width; x++) dst[x] = blend_argb( dst[x], src[x] );
+}
+
