+        if (target->filter && !match_filter( name, target->filter )) return FILEOP_SKIP;
+        if (strlen( target->dir ) + 1 + strlen( name ) >= sizeof(info->FullTargetName)) return FILEOP_SKIP;
+        sprintf( info->FullTargetName, "%s\\%s", target->dir, name );
+        target->extracted++;
+        return FILEOP_DOIT;
+    }
+    default: return NO_ERROR;
+    }
+}
