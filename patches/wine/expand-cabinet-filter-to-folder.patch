+struct cabinet_target
+{
+    const char *dir;
+    const char *filter;
+    unsigned int extracted;
+};
+
+static BOOL match_filter( const char *name, const char *filter )
+{
+    if (!*filter) return !*name;
+    if (*filter == '*')
+    {
+        while (*filter == '*') filter++;
+        if (!*filter) return TRUE;
+        for (; *name; name++)
+            if (match_filter( name, filter )) return TRUE;
+        return FALSE;
+    }
+    if (!*name) return FALSE;
+    if (*filter != '?' && tolower( (unsigned char)*filter ) != tolower( (unsigned char)*name ))
+        return FALSE;
+    return match_filter( name + 1, filter + 1 );
+}
+
+static const char *base_name( const char *path )
+{
+    const char *p, *ret = path;
+    for (p = path; *p; p++)
+        if (*p == '\\' || *p == '/') ret = p + 1;
+    return ret;
+}
