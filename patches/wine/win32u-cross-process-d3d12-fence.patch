+static void d3d12_fence_info_init( struct d3d12_fence_info *info, struct d3d12_fence_timeline *t )
+{
+    struct stat st;
+
+    info->type = 1;
+    info->pid = GetCurrentProcessId();
+    info->t = t;
+    info->unix_pid = t->pid;
+    info->fd = t->fd;
+    if (t->fd != -1 && !fstat( t->fd, &st ))
+    {
+        info->dev = st.st_dev;
+        info->ino = st.st_ino;
+    }
+}
+
+static struct d3d12_fence_timeline *d3d12_fence_timeline_open( const struct d3d12_fence_info *info )
+{
+    struct d3d12_fence_timeline *t = MAP_FAILED;
+    char path[64];
+    struct stat st;
+    int fd;
+
+    if (info->fd == -1 || !info->ino) return NULL;
+    snprintf( path, sizeof(path), "/proc/%u/fd/%d", info->unix_pid, info->fd );
+    if ((fd = open( path, O_RDWR | O_CLOEXEC )) == -1) return NULL;
+    if (!fstat( fd, &st ) && st.st_dev == info->dev && st.st_ino == info->ino && st.st_size >= sizeof(*t))
+        t = mmap( NULL, sizeof(*t), PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0 );
+    close( fd );
+    return t == MAP_FAILED ? NULL : t;
+}
