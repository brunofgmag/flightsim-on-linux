+static struct d3d12_fence_timeline *d3d12_fence_timeline_create(void)
+{
+    struct d3d12_fence_timeline *t = MAP_FAILED;
+    pthread_mutexattr_t attr;
+    int fd = -1;
+
+#ifdef HAVE_MEMFD_CREATE
+    if ((fd = memfd_create( "wine-d3d12-fence", MFD_CLOEXEC )) != -1)
+    {
+        if (!ftruncate( fd, sizeof(*t) ))
+            t = mmap( NULL, sizeof(*t), PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0 );
+        if (t == MAP_FAILED)
+        {
+            close( fd );
+            fd = -1;
+        }
+    }
+#endif
+    if (t == MAP_FAILED && !(t = calloc( 1, sizeof(*t) ))) return NULL;
+
+    t->pid = getpid();
+    t->fd = fd;
+    t->ref = 1;
+    pthread_mutexattr_init( &attr );
+    pthread_mutexattr_setpshared( &attr, PTHREAD_PROCESS_SHARED );
+    pthread_mutexattr_setrobust( &attr, PTHREAD_MUTEX_ROBUST );
+    pthread_mutex_init( &t->mutex, &attr );
+    pthread_mutexattr_destroy( &attr );
+    return t;
+}
