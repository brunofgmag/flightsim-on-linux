+int vkd3d_root_signature_cache_init(struct vkd3d_root_signature_cache *cache)
+{
+    cache->entries = NULL;
+    cache->entries_size = 0;
+    cache->entry_count = 0;
+    return pthread_mutex_init(&cache->mutex, NULL);
+}
+
+void vkd3d_root_signature_cache_cleanup(struct vkd3d_root_signature_cache *cache)
+{
+    size_t i;
+
+    for (i = 0; i < cache->entry_count; i++)
+        vkd3d_free(cache->entries[i].blob);
+
+    vkd3d_free(cache->entries);
+    pthread_mutex_destroy(&cache->mutex);
+}
+
+static uint32_t vkd3d_root_signature_cache_hash(const void *bytecode, size_t bytecode_length)
+{
+    const uint8_t *data = bytecode;
+    uint64_t hash = hash_fnv1_init();
+    size_t i;
+
+    for (i = 0; i < bytecode_length; i++)
+        hash = hash_fnv1_iterate_u8(hash, data[i]);
+
+    return (uint32_t)(hash ^ (hash >> 32));
+}
+
+static struct vkd3d_root_signature_cache_entry *vkd3d_root_signature_cache_find(
+        struct vkd3d_root_signature_cache *cache, uint32_t hash, const void *bytecode, size_t bytecode_length)
+{
+    struct vkd3d_root_signature_cache_entry *entry;
+    size_t i;
+
+    for (i = 0; i < cache->entry_count; i++)
+    {
+        entry = &cache->entries[i];
+
+        if (entry->hash == hash && entry->blob_size == bytecode_length &&
+                !memcmp(entry->blob, bytecode, bytecode_length))
+            return entry;
+    }
+
+    return NULL;
+}
+
+static bool d3d12_root_signature_try_add_ref(struct d3d12_root_signature *root_signature)
+{
+    uint32_t refcount, cas_refcount;
+
+    cas_refcount = vkd3d_atomic_uint32_load_explicit(&root_signature->refcount, vkd3d_memory_order_relaxed);
+
+    do
+    {
+        if (!(refcount = cas_refcount))
+            return false;
+
+        cas_refcount = vkd3d_atomic_uint32_compare_exchange((uint32_t *)&root_signature->refcount,
+                refcount, refcount + 1, vkd3d_memory_order_acq_rel, vkd3d_memory_order_relaxed);
+    } while (cas_refcount != refcount);
+
+    return true;
+}
+
+struct d3d12_root_signature *vkd3d_root_signature_cache_acquire(struct vkd3d_root_signature_cache *cache,
+        const void *bytecode, size_t bytecode_length)
+{
+    struct vkd3d_root_signature_cache_entry *entry;
+    struct d3d12_root_signature *root_signature = NULL;
+    uint32_t hash;
+
+    if (!bytecode || !bytecode_length)
+        return NULL;
+
+    hash = vkd3d_root_signature_cache_hash(bytecode, bytecode_length);
+
+    pthread_mutex_lock(&cache->mutex);
+
+    entry = vkd3d_root_signature_cache_find(cache, hash, bytecode, bytecode_length);
+
+    if (entry && d3d12_root_signature_try_add_ref(entry->root_signature))
+        root_signature = entry->root_signature;
+
+    pthread_mutex_unlock(&cache->mutex);
+    return root_signature;
+}
+
+static void vkd3d_root_signature_cache_append(struct vkd3d_root_signature_cache *cache, uint32_t hash,
+        struct d3d12_root_signature *root_signature, const void *bytecode, size_t bytecode_length)
+{
+    struct vkd3d_root_signature_cache_entry *entry;
+    void *blob;
+
+    if (!(blob = vkd3d_malloc(bytecode_length)))
+        return;
+
+    if (!vkd3d_array_reserve((void **)&cache->entries, &cache->entries_size,
+            cache->entry_count + 1, sizeof(*cache->entries)))
+    {
+        vkd3d_free(blob);
+        return;
+    }
+
+    memcpy(blob, bytecode, bytecode_length);
+
+    entry = &cache->entries[cache->entry_count++];
+    entry->hash = hash;
+    entry->blob_size = bytecode_length;
+    entry->blob = blob;
+    entry->root_signature = root_signature;
+}
+
+void vkd3d_root_signature_cache_insert(struct vkd3d_root_signature_cache *cache,
+        struct d3d12_root_signature *root_signature, const void *bytecode, size_t bytecode_length)
+{
+    struct vkd3d_root_signature_cache_entry *entry;
+    uint32_t hash;
+
+    hash = vkd3d_root_signature_cache_hash(bytecode, bytecode_length);
+
+    pthread_mutex_lock(&cache->mutex);
+
+    if ((entry = vkd3d_root_signature_cache_find(cache, hash, bytecode, bytecode_length)))
+        entry->root_signature = root_signature;
+    else
+        vkd3d_root_signature_cache_append(cache, hash, root_signature, bytecode, bytecode_length);
+
+    pthread_mutex_unlock(&cache->mutex);
+}
+
+void vkd3d_root_signature_cache_remove(struct vkd3d_root_signature_cache *cache,
+        struct d3d12_root_signature *root_signature)
+{
+    size_t i;
+
+    pthread_mutex_lock(&cache->mutex);
+
+    for (i = 0; i < cache->entry_count; i++)
+    {
+        if (cache->entries[i].root_signature != root_signature)
+            continue;
+
+        vkd3d_free(cache->entries[i].blob);
+        cache->entries[i] = cache->entries[--cache->entry_count];
+        break;
+    }
+
+    pthread_mutex_unlock(&cache->mutex);
+}
