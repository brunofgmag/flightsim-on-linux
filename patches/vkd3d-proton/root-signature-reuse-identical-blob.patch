+void test_create_root_signature_identical_blob(void)
+{
+    ID3D12RootSignature *root_signature, *root_signature2, *other_root_signature;
+    D3D12_ROOT_SIGNATURE_DESC root_signature_desc, other_desc;
+    D3D12_ROOT_PARAMETER root_parameter, other_parameter;
+    ID3D12Object *object;
+    unsigned int refcount;
+    ID3D12Device *device;
+    ID3DBlob *blob;
+    uint8_t *copy;
+    SIZE_T size;
+    HRESULT hr;
+
+    if (!(device = create_device()))
+    {
+        skip("Failed to create device.\n");
+        return;
+    }
+
+    root_parameter.ParameterType = D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS;
+    root_parameter.Constants.ShaderRegister = 0;
+    root_parameter.Constants.RegisterSpace = 0;
+    root_parameter.Constants.Num32BitValues = 4;
+    root_parameter.ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+    root_signature_desc.NumParameters = 1;
+    root_signature_desc.pParameters = &root_parameter;
+    root_signature_desc.NumStaticSamplers = 0;
+    root_signature_desc.pStaticSamplers = NULL;
+    root_signature_desc.Flags = D3D12_ROOT_SIGNATURE_FLAG_NONE;
+
+    other_parameter = root_parameter;
+    other_parameter.Constants.Num32BitValues = 8;
+    other_desc = root_signature_desc;
+    other_desc.pParameters = &other_parameter;
+
+    hr = create_root_signature(device, &root_signature_desc, &root_signature);
+    ok(hr == S_OK, "Failed to create root signature, hr %#x.\n", (int)hr);
+    hr = create_root_signature(device, &root_signature_desc, &root_signature2);
+    ok(hr == S_OK, "Failed to create root signature, hr %#x.\n", (int)hr);
+    ok(root_signature == root_signature2,
+            "Got different root signatures %p and %p for identical blobs.\n", root_signature, root_signature2);
+    refcount = ID3D12RootSignature_Release(root_signature2);
+    ok(refcount == 1, "Got unexpected refcount %u.\n", refcount);
+
+    hr = D3D12SerializeRootSignature(&root_signature_desc, D3D_ROOT_SIGNATURE_VERSION_1_0, &blob, NULL);
+    ok(hr == S_OK, "Failed to serialize root signature, hr %#x.\n", (int)hr);
+    size = ID3D10Blob_GetBufferSize(blob);
+    copy = malloc(size);
+    memcpy(copy, ID3D10Blob_GetBufferPointer(blob), size);
+    ID3D10Blob_Release(blob);
+    hr = ID3D12Device_CreateRootSignature(device, 0, copy, size,
+            &IID_ID3D12Object, (void **)&object);
+    ok(hr == S_OK, "Failed to create root signature, hr %#x.\n", (int)hr);
+    ok((void *)object == (void *)root_signature,
+            "Got different root signatures %p and %p for identical blobs.\n", object, root_signature);
+    refcount = ID3D12Object_Release(object);
+    ok(refcount == 1, "Got unexpected refcount %u.\n", refcount);
+    free(copy);
+
+    hr = create_root_signature(device, &other_desc, &other_root_signature);
+    ok(hr == S_OK, "Failed to create root signature, hr %#x.\n", (int)hr);
+    ok(other_root_signature != root_signature,
+            "Got the same root signature %p for different blobs.\n", root_signature);
+    refcount = get_refcount(other_root_signature);
+    ok(refcount == 1, "Got unexpected refcount %u.\n", refcount);
+    refcount = get_refcount(root_signature);
+    ok(refcount == 1, "Got unexpected refcount %u.\n", refcount);
+    refcount = ID3D12RootSignature_Release(other_root_signature);
+    ok(!refcount, "ID3D12RootSignature has %u references left.\n", refcount);
+
+    refcount = ID3D12RootSignature_Release(root_signature);
+    ok(!refcount, "ID3D12RootSignature has %u references left.\n", refcount);
+
+    hr = create_root_signature(device, &root_signature_desc, &root_signature2);
+    ok(hr == S_OK, "Failed to create root signature, hr %#x.\n", (int)hr);
+    refcount = get_refcount(root_signature2);
+    ok(refcount == 1, "Got unexpected refcount %u.\n", refcount);
+    refcount = ID3D12RootSignature_Release(root_signature2);
+    ok(!refcount, "ID3D12RootSignature has %u references left.\n", refcount);
+
+    refcount = ID3D12Device_Release(device);
+    ok(!refcount, "ID3D12Device has %u references left.\n", refcount);
+}
+
+struct create_root_signature_thread_data
+{
+    ID3D12Device *device;
+    const void *blob;
+    SIZE_T size;
+};
+
+static void create_root_signature_thread_main(void *untyped_data)
+{
+    struct create_root_signature_thread_data *data = untyped_data;
+    ID3D12RootSignature *root_signature;
+    unsigned int refcount;
+    unsigned int i;
+    HRESULT hr;
+
+    for (i = 0; i < 20000; ++i)
+    {
+        hr = ID3D12Device_CreateRootSignature(data->device, 0, data->blob, data->size,
+                &IID_ID3D12RootSignature, (void **)&root_signature);
+        ok(hr == S_OK, "Failed to create root signature, hr %#x.\n", (int)hr);
+        refcount = ID3D12RootSignature_AddRef(root_signature);
+        ok(refcount >= 2 && refcount <= 10, "Got unexpected refcount %u.\n", refcount);
+        ID3D12RootSignature_Release(root_signature);
+        ID3D12RootSignature_Release(root_signature);
+    }
+}
+
+void test_multithread_create_root_signature(void)
+{
+    struct create_root_signature_thread_data thread_data;
+    D3D12_ROOT_SIGNATURE_DESC root_signature_desc;
+    ID3D12RootSignature *root_signature;
+    D3D12_ROOT_PARAMETER root_parameter;
+    HANDLE threads[4];
+    unsigned int refcount;
+    ID3D12Device *device;
+    ID3DBlob *blob;
+    unsigned int i;
+    HRESULT hr;
+
+    if (!(device = create_device()))
+    {
+        skip("Failed to create device.\n");
+        return;
+    }
+
+    root_parameter.ParameterType = D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS;
+    root_parameter.Constants.ShaderRegister = 0;
+    root_parameter.Constants.RegisterSpace = 0;
+    root_parameter.Constants.Num32BitValues = 4;
+    root_parameter.ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+    root_signature_desc.NumParameters = 1;
+    root_signature_desc.pParameters = &root_parameter;
+    root_signature_desc.NumStaticSamplers = 0;
+    root_signature_desc.pStaticSamplers = NULL;
+    root_signature_desc.Flags = D3D12_ROOT_SIGNATURE_FLAG_NONE;
+    hr = D3D12SerializeRootSignature(&root_signature_desc, D3D_ROOT_SIGNATURE_VERSION_1_0, &blob, NULL);
+    ok(hr == S_OK, "Failed to serialize root signature, hr %#x.\n", (int)hr);
+
+    thread_data.device = device;
+    thread_data.blob = ID3D10Blob_GetBufferPointer(blob);
+    thread_data.size = ID3D10Blob_GetBufferSize(blob);
+
+    for (i = 0; i < ARRAY_SIZE(threads); ++i)
+        threads[i] = create_thread(create_root_signature_thread_main, &thread_data);
+
+    create_root_signature_thread_main(&thread_data);
+
+    for (i = 0; i < ARRAY_SIZE(threads); ++i)
+        ok(join_thread(threads[i]), "Failed to join thread %u.\n", i);
+
+    hr = ID3D12Device_CreateRootSignature(device, 0, thread_data.blob, thread_data.size,
+            &IID_ID3D12RootSignature, (void **)&root_signature);
+    ok(hr == S_OK, "Failed to create root signature, hr %#x.\n", (int)hr);
+    refcount = ID3D12RootSignature_Release(root_signature);
+    ok(!refcount, "ID3D12RootSignature has %u references left.\n", refcount);
+
+    ID3D10Blob_Release(blob);
+    refcount = ID3D12Device_Release(device);
+    ok(!refcount, "ID3D12Device has %u references left.\n", refcount);
+}
